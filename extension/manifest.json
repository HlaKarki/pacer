{
  "manifest_version": 3,
  "name": "Pacer",
  "version": "0.1.0",
  "description": "Read the PDF or article in this tab with a highlighter that moves at your pace.",
  "minimum_chrome_version": "128",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["file:///*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Pace this page",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } }
  }
}
